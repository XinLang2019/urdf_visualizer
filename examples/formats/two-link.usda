    def "Joints"
    {
        def PhysicsFixedJoint "J0_base__fixed"
        {
            rel physics:body0 = </Robot/Links/L0_world>
            rel physics:body1 = </Robot/Links/L1_base>
            point3f physics:localPos0 = (0, 0, 0.8)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            custom string urdf:name = "base__fixed"
        }

        def PhysicsRevoluteJoint "J1_hinge" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 0
            float drive:angular:physics:maxForce = 12
            float drive:angular:physics:stiffness = 0
            uniform token physics:axis = "X"
            rel physics:body0 = </Robot/Links/L1_base>
            rel physics:body1 = </Robot/Links/L2_arm>
            point3f physics:localPos0 = (0.2, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0.70710677, 0, 0, 0.70710677)
            quatf physics:localRot1 = (0.70710677, 0, 0, 0.70710677)
            float physics:lowerLimit = -68.75494
            float physics:upperLimit = 68.75494
            custom double urdf:damping = 0
            custom double urdf:friction = 0
            custom string urdf:name = "hinge"
            custom double urdf:velocity = 0
        }

        def PhysicsFixedJoint "WorldAnchor"
        {
            rel physics:body1 = </Robot/Links/L0_world>
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            custom string urdf:name = "__world_anchor"
        }
    }
}

