                float[] primvars:displayOpacity = [1]
                uniform token subdivisionScheme = "none"
                custom string urdf:role = "visual"
            }

            def Mesh "collision_0" (
                prepend apiSchemas = ["PhysicsCollisionAPI"]
            )
            {
