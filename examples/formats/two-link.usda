#usda 1.0
(
    defaultPrim = "Robot"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Robot" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI"]
    doc = "Portable robot geometry / articulation; see conversion-report.json for differences."
)
{
    custom string urdf:modelName = "two_link_usd"
    custom string urdf:rootLink = "world"

    def "Links"
    {
        def Xform "L0_world" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI"]
        )
        {
            bool physics:kinematicEnabled = 1
            custom string urdf:name = "world"
            quatf xformOp:orient = (1, 0, 0, 0)
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
        }

        def Xform "L1_base" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        )
